<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Pleos Connect 권한 — 쓰는 API 에 해당하는 것만 선언한다.
      NaviHelper: get*Info() = NAVI_ROUTE · addWaypoint() = NAVI_ROUTE_SEARCH (공식 문서 NaviHelper/declaring-permissions)
      TextToSpeech: TTS_SERVICE (공식 문서 TextToSpeech/declaring-permissions)
      Vehicle: 잔량·효율 = CAR_ENERGY · 용량 = CAR_INFO (SDK 의 @RequiresPermission 을 javap 로 읽음, 2026-10-25)
      VEHICLE_BINDING 은 Vehicle SDK 가 자기 매니페스트로 합쳐 넣는다.
    -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- Pleos 서비스가 없는 기기(일반 폰)에서 Android 기본 TTS 로 물러날 때 엔진을 찾기 위해 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CommaDrive">
        <!--
          세로가 기본, 가로는 확장 — 앱 창 크기는 시스템이 정한다(Pleos 창 1~2개). 방향을 고정하지 않고
          창이 바뀌어도 상태를 잃지 않게 configChanges 로 직접 받는다.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
